# Database Connection:
# Local Development (Viewable via Beekeeper Studio on port 5432)
# Tip: Replace 'postgres:postgres' with your local Postgres user/password if different (e.g. tejovarmaalluri)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wind_procure_iq

# Neon Production Database (Uncomment when deploying to Neon)
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-cold-wind-123456-pooler.eu-central-1.aws.neon.tech/neondb?ssl=require

# Elexon BMRS API Configuration
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_API_KEY=

# Trading Gate Closure Cutoff Hour (11:00 UTC on D-1)
DEFAULT_DECISION_CUTOFF_HOUR=11

# Great Britain Total Installed Wind Benchmark (MW)
INSTALLED_WIND_CAPACITY_MW=30000.0

# Server Environment
ENVIRONMENT=development
PORT=8000
